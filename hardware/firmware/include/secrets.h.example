// Modelo de credenciais do firmware (versionado). Copie para include/secrets.h (fora do Git) e preencha.
// Sem secrets.h o firmware compila com estes valores vazios e não conecta a nenhuma rede.
// MQTT_HOST e MQTT_PORT também podem vir das variáveis de ambiente na compilação (scripts/endereco_broker.py).
#pragma once

// Nome (SSID) da rede Wi-Fi 2,4 GHz do posto.
#ifndef WIFI_SSID
#define WIFI_SSID ""
#endif

// Senha da rede Wi-Fi.
#ifndef WIFI_SENHA
#define WIFI_SENHA ""
#endif

// Endereço do broker MQTT visto pela placa (IP do computador que roda a base; "localhost" não serve na placa).
#ifndef MQTT_HOST
#define MQTT_HOST ""
#endif

// Porta do broker MQTT (a base usa 1883).
#ifndef MQTT_PORT
#define MQTT_PORT 1883
#endif

// Usuário do broker; vazio = anônimo (o broker da base aceita anônimo).
#ifndef MQTT_USUARIO
#define MQTT_USUARIO ""
#endif

// Senha do broker; vazia = anônimo.
#ifndef MQTT_SENHA
#define MQTT_SENHA ""
#endif
